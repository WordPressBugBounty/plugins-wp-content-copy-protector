#: admin-core.php:1040
msgid "Compatible with PHP 8.2 and 8.3, ZeptoJS and the jQuery slim builds."
msgstr "Compatibile con PHP 8.2 e 8.3, ZeptoJS e versioni slim di jQuery."

#: admin-core.php:1041
