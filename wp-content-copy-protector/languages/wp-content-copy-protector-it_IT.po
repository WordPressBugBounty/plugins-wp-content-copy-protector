msgstr "Compatibile con Elementor, SiteOrigin, Beaver Builder, la modalità anteprima di WordPress e wpDiscuz."

#: admin-core.php:1038
msgid "Compatible with all major theme frameworks and all major browsers."
msgstr "Compatibile con tutti i principali framework di temi e browser moderni."

#: admin-core.php:1039
